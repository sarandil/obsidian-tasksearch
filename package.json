{
  "name": "task-search",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --format=cjs --target=es2020 --platform=browser --external:obsidian --external:electron --outfile=main.js",
    "test": "esbuild src/logic.ts --format=cjs --outfile=.test/logic.cjs --log-level=warning && node --test test/logic.test.cjs",
    "dev": "esbuild src/main.ts --bundle --format=cjs --target=es2020 --platform=browser --external:obsidian --external:electron --outfile=main.js --watch",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.14.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0"
  },
  "description": "Lists tasks from notes whose properties match a query, grouped by frontmatter title, with live filters by text, tag and task status.",
  "license": "MIT",
  "type": "module"
}
